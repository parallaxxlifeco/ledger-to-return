#!/bin/sh
# Refuse to commit anything that could carry financial data.
#
# This repository is public: GitHub Pages is only free on public repos, so the
# code and its whole history are readable by anyone. Statements, exports and
# saved app data must never reach it. .gitignore already keeps them out; this
# is the second lock, because .gitignore only helps for paths it knows about
# and does nothing against `git add -f`.
#
# Installed with:  git config core.hooksPath .githooks

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)

# 1. File types that are statements or exports, whatever they are called.
for f in $staged; do
  case "$f" in
    build/rates.json) ;;                      # ECB reference rates, public data
    test/fixtures/wise-sample.csv) ;;         # invented names and ids; the Wise test needs it
    *.pdf|*.csv|*.tsv|*.ofx|*.qif|*.xls|*.xlsx|*.json)
      echo "BLOCKED  $f"
      echo "         Statements, exports and saved data do not belong in a public repo."
      fail=1 ;;
  esac
done

# 2. Content that looks like a card number or the app's own save file, in case
#    it was pasted into a note, a test or a log rather than committed as a file.
for f in $staged; do
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -Eq '\b[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}\b'; then
    echo "BLOCKED  $f contains something shaped like a card number."
    fail=1
  fi
  if git show ":$f" 2>/dev/null | grep -q '"tx"[[:space:]]*:[[:space:]]*\['; then
    echo "BLOCKED  $f looks like a Ledger to Return backup."
    fail=1
  fi
done

if [ "$fail" = 1 ]; then
  echo
  echo "Nothing was committed."
  echo "If a file really is safe to publish, commit it with --no-verify and be sure."
  exit 1
fi
